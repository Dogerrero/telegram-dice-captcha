# Токен бота из @BotFather
API_TOKEN=ВСТАВЬТЕ_ТОКЕН_БОТА

# Необязательные ID супергрупп через запятую; новые группы добавляются автоматически
ALLOWED_CHAT_IDS=

# Файл настроек приветствия (в нём не хранятся пользователи)
SETTINGS_FILE=./settings.json

# Необязательные параметры (значения по умолчанию)
# CAPTCHA_TIMEOUT_SECONDS=120
# BAN_TIMEOUT_SECONDS=30
# Бан после проваленной капчи, секунды (0 — исключить без бана; иначе 60..31622400)
# FAIL_BAN_SECONDS=1800
# Запас к сроку ограничения на время капчи (снимается Telegram сам после перезапуска бота)
# CAPTCHA_LOCK_MARGIN_SECONDS=300
# MESSAGE_DELETE_TIMEOUT_SECONDS=300
# MAX_CAPTCHA_ATTEMPTS=2
# MAX_ACTIVE_CAPTCHAS_PER_CHAT=50
# JOIN_WINDOW_SECONDS=60
# MAX_JOINS_PER_CHAT_WINDOW=30
# API_RETRY_DELAY_SECONDS=30
# LOG_LEVEL=INFO
